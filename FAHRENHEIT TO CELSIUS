# Function to convert Fahrenheit to Celsius
fahrenheit_to_celsius <- function(fahrenheit) {
  
  # Conversion formula
  celsius <- (fahrenheit - 32) * 5 / 9
  
  # Return Celsius value
  return(celsius)
}

# Get input from user
temp <- as.numeric(
  readline("Enter temperature in Fahrenheit: ")
)

# Call the function
result <- fahrenheit_to_celsius(temp)

# Display input
cat("Temperature in Fahrenheit:", temp, "\n")

# Display converted value
cat("Temperature in Celsius:",
    round(result, 2), "\n")

# Display conversion message
cat("Conversion completed successfully.\n")
